# ── Radhiant Brain environment ────────────────────────────────────────────────
# Copy this file to .env.local and fill in real values. Never commit .env.local.

# 1. Claude API (powers the assistant). Get a key at https://console.anthropic.com
#    Until this is set, the app runs in knowledge-search mode (no AI generation).
ANTHROPIC_API_KEY=PLACEHOLDER_ANTHROPIC_API_KEY

# Model used for chat. Must be an ID listed at https://platform.claude.com/docs/en/models/overview
RB_CHAT_MODEL=claude-sonnet-5-5

# 2. Session signing secret. Any long random string (32+ chars).
#    Generate one: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
RB_SESSION_SECRET=PLACEHOLDER_CHANGE_ME_LONG_RANDOM_STRING

# 3. Access passcodes, one per tier. Share each only with the right group.
#    team       → every Radhiant staff member
#    leadership → heads + fractional advisors
#    ceo        → Anith only
RB_TEAM_PASSCODE=PLACEHOLDER_TEAM_PASSCODE
RB_LEADERSHIP_PASSCODE=PLACEHOLDER_LEADERSHIP_PASSCODE
RB_CEO_PASSCODE=PLACEHOLDER_CEO_PASSCODE

# 4. Optional: app-wide daily chat ceiling across every session (default 400).
# RB_DAILY_CHAT_CEILING=400

# 5. Optional, later: Microsoft Entra ID SSO (replaces passcodes when ready).
#    Leave blank for now; the app ignores these until implemented.
# ENTRA_TENANT_ID=
# ENTRA_CLIENT_ID=
# ENTRA_CLIENT_SECRET=
